PORT=3000

# Criados no Google Cloud Console > APIs e Serviços > Credenciais
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Em produção (Koyeb), use a URL pública: https://SEU-APP.koyeb.app/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Pasta raiz do Drive para restringir o escopo de busca (setor comercial).
# Pegue o ID na URL da pasta no Drive: https://drive.google.com/drive/folders/<ID>
DRIVE_ROOT_FOLDER_ID=

# Upstash Redis — crie em https://console.upstash.com (plano gratuito)
# Necessário para tokens OAuth sobreviverem a reinicializações do servidor
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
